{
  "name": "od-breadcrumb-schema",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:status": "wp-env status",
    "env:logs": "wp-env logs",
    "env:cli": "wp-env run cli wp",
    "composer": "wp-env run cli --env-cwd=wp-content/plugins/od-breadcrumb-schema composer",
    "lint:php": "wp-env run cli --env-cwd=wp-content/plugins/od-breadcrumb-schema composer lint",
    "build": "python3 scripts/build-release.py",
    "test": "wp-env run cli --env-cwd=wp-content/plugins/od-breadcrumb-schema php tests/run.php /var/www/html"
  },
  "devDependencies": {
    "@wordpress/env": "^12.2.0"
  }
}
